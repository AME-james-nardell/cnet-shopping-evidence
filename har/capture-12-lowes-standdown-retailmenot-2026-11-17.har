      "text": "[{\"id\":28,\"name\":\"Lowes\",\"url\":\"lowes.com\",\"order_complete\":\"lowes\\\\.com\\\\/checkout\\\\/(?:confirmation|confirm)\\\\/[0-9]*\",\"metadata\":\"{\\\"scrape_timeout\\\":\\\"500\\\"}\",\"title\": \"return getXPathContent(\\\"//h1\\\")\",\"coupon_input_selector\": \"[name=\\\"promoCode\\\"], #promocode-input\",\"coupon_submit_selector\": \"[data-automation-id=\\\"apply-promo-code\\\"]\",\"total_price_selector\": \"div:contains(\\\"Total\\\") + div > [data-selector*=\\\"Total\\\"]:not(:contains(\\\"0.00\\\")), [class*=\\\"Total\\\"].strong\",\"ac_remove_promo_code\": \"[data-automation-id=\\\"remove-promo-code\\\"], .js-remove-promo\",\"ac_pre_apply_codes\": \"[data-automation-id=\\\"accordion-addPromoCode-toggleIcon\\\"]\",\"ac_cart_page_check_selector\": \"[data-automation-id=\\\"add-promo-code\\\"], [data-automation-id=\\\"remove-promo-code\\\"], [href=\\\"#promoApplyToggle\\\"], .js-remove-promo\",\"ac_cart_reload\": \"0\",\"ac_submit_delay\": \"6\",\"ac_finish_delay\": \"3\",\"ac_initcode\": \"[data-automation-id=\\\"promo-code-text\\\"], #promocode-input\",\"act_coupon_input_selector\": \"[name=\\\"promoCode\\\"], #promocode-input\",\"act_coupon_submit_selector\": \"[data-automation-id=\\\"apply-promo-code\\\"]\",\"act_pre_apply_codes\": \"[data-automation-id=\\\"accordion-addPromoCode-toggleIcon\\\"]\",\"act_remove_promo_code\": \"[data-automation-id=\\\"remove-promo-code\\\"], .js-remove-promo\",\"act_bypass_transition_logic\": \"0\",\"price\": \"return getXPathContent(\\\"concat(normalize-space(//span[@class='screen-reader']),'_~_',//div[@class='main-price undefined split split-left'],'_~_',//div[@class='sticky-price'])\\\")\",\"mpn\": \"return getXPathContent(\\\"substring-after(//p[contains(text(),'Model #')],'Model #')\\\")\",\"brand\": \"return getXPathContent(\\\"concat(substring-after(//a[@class='LinkBase-sc-2ngoxx-0 eViSzl backyard link size--medium color--text_link shop-brand']//span[@class='label link-label'],'Shop '),'_~_',substring-before(substring-after(substring-after(//script[contains(text(),'productId')],'brand'),':'),','))\\\")\",\"upc\": \"return getXPathContent(\\\"substring(substring-before(substring(substring-after(//script[contains(text(),'barcode')],'barcode'),4),','),0,string-length(substring-before(substring(substring-after(//script[contains(text(),'barcode')],'barcode'),4),',')))\\\")\",\"sku\": \"return getXPathContent(\\\"substring-before(substring-after(//p[contains(text(),'Item #')],'Item #'),' ')\\\")\",\"rating\": \"return getXPathContent(\\\"substring-before((//div[@class='BVRRRatingNormalImage']//img)[1]/@alt,' ')\\\")\",\"c1\": \"return getXPathContent(\\\"substring-before(normalize-space((//span[@class='productRating']/text())[2]),' ')\\\")\",\"manifest_v3_flag\": 1}]"
